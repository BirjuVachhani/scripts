#!/bin/bash

# USAGE: Recursively searches for pubspec.yaml files under current directory and cleans Flutter/Dart projects.

# ==============================================================================
# LOAD CORE UTILITIES
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE_LIB="$SCRIPT_DIR/core.sh"

if [ ! -f "$CORE_LIB" ]; then
    echo "Error: core.sh not found at $CORE_LIB"
    echo "Please ensure core.sh is in the same directory as this script."
    exit 1
fi

source "$CORE_LIB"

# ==============================================================================
# SCRIPT FUNCTIONS
# ==============================================================================

# Print script usage
print_usage() {
    echo "Usage: $0 [directory]"
    echo "If directory is not specified, current directory will be used."
    echo "The script will recursively search for pubspec.yaml files and clean Flutter/Dart projects by:"
    echo "  - Deleting 'build' directories"
    echo "  - Deleting '.dart_tool' directories"
    echo "  - Deleting 'pubspec.lock' files (only if not tracked in git)"
    echo "  - Deleting anything listed under 'clean.include' in flutterclean.yaml"
    echo ""
    echo "Configuration:"
    echo "  - Exclude patterns: Edit .flutterclean-exclude in the scripts directory"
    echo "  - Extra rules: flutterclean.yaml in the directory being cleaned, or in"
    echo "    the scripts directory as a global default. Its glob patterns are"
    echo "    relative to the directory being cleaned and win over the rules above."
    echo ""
    echo "    clean:"
    echo "      include:      # deleted in addition to the built-in targets"
    echo "        - \"**/node_modules/**\""
    echo "      exclude:      # never deleted, not even the built-in targets"
    echo "        - \"**/hyper_zones\""
    echo ""
    echo "    traverse:"
    echo "      exclude:      # never searched"
    echo "        - \"**/build/**\""
    echo "      include:      # searched even when excluded above"
    echo "        - \"**/apps/web\""
}

# Load the rules from flutterclean.yaml, if there is one
# Usage: load_config "/path/to/directory"
# Returns: Patterns in the CLEAN_* and TRAVERSE_* arrays, path in CONFIG_FILE
load_config() {
    local dir="$1"
    local pattern

    CLEAN_INCLUDE_GLOBS=()
    CLEAN_EXCLUDE_GLOBS=()
    TRAVERSE_INCLUDE_GLOBS=()
    TRAVERSE_EXCLUDE_GLOBS=()

    CONFIG_FILE=$(find_config_file "flutterclean" "$dir") || return 0

    while IFS= read -r pattern; do
        [ -n "$pattern" ] && CLEAN_INCLUDE_GLOBS+=("$pattern")
    done < <(read_yaml_list "$CONFIG_FILE" "clean" "include")

    while IFS= read -r pattern; do
        [ -n "$pattern" ] && CLEAN_EXCLUDE_GLOBS+=("$pattern")
    done < <(read_yaml_list "$CONFIG_FILE" "clean" "exclude")

    while IFS= read -r pattern; do
        [ -n "$pattern" ] && TRAVERSE_INCLUDE_GLOBS+=("$pattern")
    done < <(read_yaml_list "$CONFIG_FILE" "traverse" "include")

    while IFS= read -r pattern; do
        [ -n "$pattern" ] && TRAVERSE_EXCLUDE_GLOBS+=("$pattern")
    done < <(read_yaml_list "$CONFIG_FILE" "traverse" "exclude")
}

# Check whether a path is shielded from deletion by clean.exclude
# Usage: is_protected "app/example/build"
# Returns: 0 if protected, 1 otherwise
#
# A match on any ancestor protects everything beneath it, so excluding a
# directory keeps its whole subtree intact.
is_protected() {
    local candidate="$1"

    [ ${#CLEAN_EXCLUDE_GLOBS[@]} -eq 0 ] && return 1

    while :; do
        if path_matches_glob "$candidate" "${CLEAN_EXCLUDE_GLOBS[@]}"; then
            return 0
        fi

        case "$candidate" in
            */*) candidate="${candidate%/*}" ;;
            *) break ;;
        esac
    done

    return 1
}

# Delete one target unless it is protected, adding its size to total_size
# Usage: remove_target "build" "app/example/build"
# Returns: Exit code of the removal
#
# Reads and updates total_size from the calling function.
remove_target() {
    local target="$1"
    local rel="$2"
    local size

    [ -e "$target" ] || return 0
    is_protected "$rel" && return 0

    size=$(calculate_size "$target")
    total_size=$((total_size + size))

    rm -rf "$target" 2>/dev/null
}

# Clean a single project directory and return size cleaned in bytes
# Usage: clean_project "/abs/path/to/project" "relative/path/to/project"
clean_project() {
    local project_dir="$1"
    local project_rel="$2"
    local success=0
    local result
    local total_size=0
    local rel_prefix=""

    # Prefix that turns a name inside the project into a path relative to the
    # directory being cleaned, which is what the config globs match against.
    if [ -n "$project_rel" ] && [ "$project_rel" != "." ]; then
        rel_prefix="$project_rel/"
    fi

    # Change to project directory
    cd "$project_dir" || return 1

    # Delete "build" directory
    remove_target "build" "${rel_prefix}build"
    result=$?
    if [ $result -ne 0 ]; then
        success=$result
    fi

    # Delete ".dart_tool" directory
    remove_target ".dart_tool" "${rel_prefix}.dart_tool"
    result=$?
    if [ $result -ne 0 ]; then
        success=$result
    fi

    # Delete "pubspec.lock" only if not tracked in git
    if [ -f "pubspec.lock" ] && ! is_git_tracked "pubspec.lock" "$project_dir"; then
        remove_target "pubspec.lock" "${rel_prefix}pubspec.lock"
        result=$?
        if [ $result -ne 0 ]; then
            success=$result
        fi
    fi

    # Delete everything matched by clean.include
    if [ ${#CLEAN_INCLUDE_GLOBS[@]} -gt 0 ]; then
        local include_paths
        include_paths=$(globs_to_find_paths "$SCAN_ROOT" "${CLEAN_INCLUDE_GLOBS[@]}")

        if [ -n "$include_paths" ]; then
            # Matched directories are pruned as well as printed, so the walk
            # never descends into a tree that is about to be removed. The
            # exclusions are rooted at SCAN_ROOT because that is what the
            # config globs are written against.
            local prune_expr
            prune_expr=$(build_prune_expr "flutterclean" "$SCAN_ROOT")

            local find_cmd
            find_cmd="find \"$project_dir\""
            find_cmd="$find_cmd \\( -path \"$project_dir\" \\) -o"
            find_cmd="$find_cmd \\( -type d \\( $include_paths \\) -prune -print0 \\) -o"
            find_cmd="$find_cmd $prune_expr"
            find_cmd="$find_cmd \\( -type f \\( $include_paths \\) -print0 \\)"

            local match_path
            while IFS= read -r -d '' match_path; do
                remove_target "$match_path" "${match_path#$SCAN_ROOT/}"
                result=$?
                if [ $result -ne 0 ]; then
                    success=$result
                fi
            done < <(eval "$find_cmd" 2>/dev/null)
        fi
    fi

    # Output the size to stdout (will be captured separately)
    echo "$total_size"

    return $success
}

# Process a directory
process_directory() {
    local dir="$1"
    local count=0
    local errors=0
    local max_name_length=0
    local total_bytes_freed=0

    # First pass: find all projects and calculate max name length
    local -a projects=()
    local find_cmd
    find_cmd=$(build_find_command "$dir" "flutterclean")

    while IFS= read -r -d '' pubspec_path; do
        local project_dir
        project_dir=$(dirname "$pubspec_path")
        local project_name
        project_name=$(get_project_name "$pubspec_path")

        projects+=("$pubspec_path")

        # Track max length
        if (( ${#project_name} > max_name_length )); then
            max_name_length=${#project_name}
        fi
    done < <(eval "$find_cmd")

    # Add padding (10-15 spaces)
    max_name_length=$((max_name_length + 12))

    # Print header
    printf "${GREY}%-7s${NC} ${GREY}%-${max_name_length}s${NC} ${GREY}%-12s${NC} ${GREY}:%s${NC}\n" "Status" "Project Name" "Freed" "Path"

    # Second pass: process all projects
    for pubspec_path in "${projects[@]}"; do
        count=$((count + 1))
        local project_dir
        project_dir=$(dirname "$pubspec_path")

        # Get relative path from target directory
        local rel_path
        rel_path=$(relativePath "$dir" "$project_dir")

        # Get project name from pubspec
        local project_name
        project_name=$(get_project_name "$pubspec_path")

        # Create padded project name
        local padded_name
        printf -v padded_name "%-${max_name_length}s" "$project_name"

        # Create temp file to capture size output
        local size_file
        size_file=$(mktemp /tmp/flutterclean_size.XXXXXX 2>/dev/null || echo "/tmp/flutterclean_size_$$_$count")

        # Run clean command in background, capturing size output
        (clean_project "$project_dir" "$rel_path" 2>/dev/null > "$size_file"; echo $? > "${size_file}.exit") &
        local pid=$!

        # Show spinner while process runs
        show_spinner $pid "$padded_name" "$rel_path"

        # Wait for process and capture result
        wait $pid 2>/dev/null
        local exit_code=$(cat "${size_file}.exit" 2>/dev/null || echo "1")
        local size_bytes=$(cat "$size_file" 2>/dev/null || echo "0")
        rm -f "$size_file" "${size_file}.exit" 2>/dev/null

        # Convert size to human-readable format
        local size_human
        size_human=$(bytes_to_human "$size_bytes")

        # Create padded size (12 chars) for alignment
        local padded_size
        printf -v padded_size "%-12s" "$size_human"

        # Add to total
        total_bytes_freed=$((total_bytes_freed + size_bytes))

        # Check result and replace spinner with status
        if [ "$exit_code" -eq 0 ]; then
            printf "\r${GREEN}%-7s${NC} ${GREEN}%s${NC} ${GREY}%s${NC} ${GREY}:%s${NC}\n" "[ok]" "$padded_name" "$padded_size" "$rel_path"
        else
            printf "\r${RED}%-7s${NC} ${RED}%s${NC} ${GREY}%s${NC} ${GREY}:%s${NC}\n" "[error]" "$padded_name" "$padded_size" "$rel_path"
            errors=$((errors + 1))
        fi
    done

    # Print summary
    local total_size_human
    total_size_human=$(bytes_to_human "$total_bytes_freed")

    echo ""
    echo "Summary:"
    echo "Total projects found: $count"
    if [ $errors -eq 0 ]; then
        echo "All projects cleaned successfully!"
    else
        echo "Failed clean operations: $errors"
        echo "Successful clean operations: $((count - errors))"
    fi
    echo "Total storage freed: $total_size_human"
    echo "----------------------------------------"
}

# ==============================================================================
# MAIN SCRIPT
# ==============================================================================

# Show help if requested
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    exit 0
fi

# Get target directory
target_dir="${1:-.}"

# Verify directory exists
if [ ! -d "$target_dir" ]; then
    log_error "Directory '$target_dir' does not exist"
    exit 1
fi

# Convert to absolute path
target_dir=$(cd "$target_dir" && pwd)

# The root that every config glob is resolved against
SCAN_ROOT="$target_dir"

# Load flutterclean.yaml, which extends and overrides the built-in rules
load_config "$target_dir"

echo "----------------------------------------"
echo "Starting Flutter clean in: $target_dir"
if [ -n "$CONFIG_FILE" ]; then
    # Show a repo-local config relative to the scan, a global one as a path
    config_display="${CONFIG_FILE#$target_dir/}"
    echo "Using config: ${config_display/#$HOME/~}"
fi
echo "----------------------------------------"

# Process the directory
process_directory "$target_dir"
