#!/bin/bash

# USAGE: Recursively searches for pubspec.yaml files under current directory and run 'flutter pub get' or 'dart pub get' based on dependencies.

# ==============================================================================
# LOAD CORE UTILITIES
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE_LIB="$SCRIPT_DIR/core.sh"

if [ ! -f "$CORE_LIB" ]; then
    echo "Error: core.sh not found at $CORE_LIB"
    echo "Please ensure core.sh is in the same directory as this script."
    exit 1
fi

source "$CORE_LIB"

# ==============================================================================
# SCRIPT FUNCTIONS
# ==============================================================================

# Print script usage
print_usage() {
    echo ""
    echo -e "${BOLD}${CYAN}pubget${NC} - Fetch dependencies for Flutter/Dart projects"
    echo ""
    echo -e "${BOLD}Usage:${NC}"
    echo "  pubget [directories...]"
    echo ""
    echo -e "${BOLD}Arguments:${NC}"
    echo -e "  ${GREEN}directories${NC}  One or more directories (defaults to current directory)"
    echo ""
    echo -e "${BOLD}Description:${NC}"
    echo "  Recursively searches for pubspec.yaml files and runs 'flutter pub get'"
    echo "  or 'dart pub get' based on project dependencies."
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  pubget                     # Run in current directory"
    echo "  pubget common              # Run in ./common"
    echo "  pubget common server       # Run in ./common and ./server"
    echo "  pubget . common server     # Run in ., ./common, and ./server"
    echo ""
    echo -e "${BOLD}Configuration:${NC}"
    echo "  - Exclude patterns: Edit .pubget-exclude in the scripts directory"
    echo "  - Environment: Edit .env for PUB_GET_NO_EXAMPLE setting"
    echo ""
    echo -e "${BOLD}Notes:${NC}"
    echo "  Packages with 'resolution: workspace' are skipped. A single pub get"
    echo "  at their workspace root resolves the whole workspace at once."
    echo ""
}

# Check if any workspace member under this root needs the Flutter SDK
# Usage: workspace_needs_flutter "/path/to/pubspec.yaml"
# Returns: 0 if a member depends on Flutter, 1 otherwise
#
# A workspace root often declares no dependencies of its own, so the choice
# between flutter and dart has to come from the members it resolves for.
workspace_needs_flutter() {
    local pubspec_path="$1"
    local root_dir
    local member

    is_workspace_root "$pubspec_path" || return 1

    root_dir=$(dirname "$pubspec_path")

    for member in "${workspace_members[@]}"; do
        case "$member" in
            "$root_dir"/*)
                if has_flutter_dependency "$member"; then
                    return 0
                fi
                ;;
        esac
    done

    return 1
}

# ==============================================================================
# MAIN SCRIPT
# ==============================================================================

# Show help if requested
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    exit 0
fi

# Check if Flutter and Dart are installed
require_command "flutter" "Flutter"
require_command "dart" "Dart"

# Store the original working directory for relative path display
original_pwd="$PWD"

# Get target directories from arguments (default to current directory)
if [ $# -eq 0 ]; then
    target_dirs=(".")
else
    target_dirs=("$@")
fi

# Verify all directories exist
for dir in "${target_dirs[@]}"; do
    if [ ! -d "$dir" ]; then
        log_error "Directory '$dir' does not exist"
        exit 1
    fi
done

# Collect all projects from all directories
all_projects=()
workspace_members=()
max_name_length=0

for target_dir in "${target_dirs[@]}"; do
    # Convert to absolute path
    target_dir=$(cd "$target_dir" && pwd)

    # Find all projects in this directory
    find_cmd=$(build_find_command "$target_dir" "pubget")

    while IFS= read -r -d '' pubspec_path; do
        # A workspace member shares one resolution with the rest of its
        # workspace, so the pub get at its root already covers it.
        if is_workspace_member "$pubspec_path"; then
            workspace_members+=("$pubspec_path")
            continue
        fi

        project_name=$(get_project_name "$pubspec_path")

        # Store project info: pubspec_path
        all_projects+=("$pubspec_path")

        # Track max length
        if (( ${#project_name} > max_name_length )); then
            max_name_length=${#project_name}
        fi
    done < <(eval "$find_cmd")
done

# Return if no projects found
if [ ${#all_projects[@]} -eq 0 ]; then
    if [ ${#workspace_members[@]} -gt 0 ]; then
        log_warning "Only workspace members found, nothing to resolve here"
        log_info "Run pubget from the workspace root that owns them"
    else
        log_warning "No Flutter/Dart projects found"
    fi
    exit 0
fi

# Add padding (10-15 spaces)
max_name_length=$((max_name_length + 12))

# Print header with directory info
echo "----------------------------------------"
if [ ${#target_dirs[@]} -eq 1 ]; then
    target_dir_display=$(relativePath "$original_pwd" "$(cd "${target_dirs[0]}" && pwd)")
    echo "Starting Flutter dependencies update in: $target_dir_display"
else
    echo "Starting Flutter dependencies update in: ${#target_dirs[@]} directories"
fi
echo "----------------------------------------"

# Print table header
printf "${GREY}%-7s${NC} ${GREY}%-${max_name_length}s${NC} ${GREY}%-8s${NC} ${GREY}:%s${NC}\n" "Status" "Project Name" "Time" "Path"

# Process all projects
count=0
errors=0
total_time=0

for pubspec_path in "${all_projects[@]}"; do
    count=$((count + 1))
    project_dir=$(dirname "$pubspec_path")

    # Get relative path from original working directory
    rel_path=$(relativePath "$original_pwd" "$project_dir")

    # Get project name from pubspec
    project_name=$(get_project_name "$pubspec_path")

    # Determine command based on Flutter dependency
    if has_flutter_dependency "$pubspec_path" || workspace_needs_flutter "$pubspec_path"; then
        command="flutter pub get"
    else
        command="dart pub get"
    fi

    # Add --no-example flag if configured (defaults to true if not set)
    use_no_example="${PUB_GET_NO_EXAMPLE:-true}"
    if [ "$use_no_example" = "true" ]; then
        command="$command --no-example"
    fi

    # Create padded project name
    printf -v padded_name "%-${max_name_length}s" "$project_name"

    # Record start time
    start_time=$(date +%s 2>/dev/null || echo "0")

    # Run command in background
    (cd "$project_dir" && eval "$command" > /dev/null 2>&1) &
    pid=$!

    # Show spinner while process runs
    show_spinner $pid "$padded_name" "$rel_path"

    # Wait for process and record end time
    exit_code=0
    wait $pid 2>/dev/null || exit_code=$?
    end_time=$(date +%s 2>/dev/null || echo "0")

    # Calculate duration
    duration=$((end_time - start_time))
    time_human=$(seconds_to_human "$duration")

    # Add to total time
    total_time=$((total_time + duration))

    # Create padded time (8 chars) for alignment
    printf -v padded_time "%-8s" "$time_human"

    # Check result and replace spinner with status
    if [ $exit_code -eq 0 ]; then
        printf "\r${GREEN}%-7s${NC} ${GREEN}%s${NC} ${GREY}%s${NC} ${GREY}:%s${NC}\n" "[ok]" "$padded_name" "$padded_time" "$rel_path"
    else
        printf "\r${RED}%-7s${NC} ${RED}%s${NC} ${GREY}%s${NC} ${GREY}:%s${NC}\n" "[error]" "$padded_name" "$padded_time" "$rel_path"
        errors=$((errors + 1))
    fi
done

# Print summary
total_time_human=$(seconds_to_human "$total_time")

echo ""
echo "Summary:"
echo "Total projects found: $count"
if [ ${#workspace_members[@]} -gt 0 ]; then
    echo "Workspace members skipped: ${#workspace_members[@]} (resolved by their workspace root)"
fi
if [ $errors -eq 0 ]; then
    echo "All projects updated successfully!"
else
    echo "Failed updates: $errors"
    echo "Successful updates: $((count - errors))"
fi
echo "Total time taken: $total_time_human"
echo "----------------------------------------"

# Exit with appropriate code
if [ $errors -gt 0 ]; then
    exit 1
else
    exit 0
fi
