# Configuration file for .scripts utilities
# Copy this file to .env and customize as needed

# Force AOT compilation for the build runner.
# When enabled, build_runner will use ahead-of-time compilation for better performance.
# Default is true.
# BUILD_RUNNER_AOT=true

# Use no-example flag for pub get
# When enabled, skips running pub get in example directories
# Default is true.
# PUB_GET_NO_EXAMPLE=true