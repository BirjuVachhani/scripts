#!/bin/bash

# Print script usage
print_usage() {
    echo "Usage: $0 [directory]"
    echo "If directory is not specified, current directory will be used."
    echo "The script will recursively search for pubspec.yaml files and run 'flutter pub get'"
}

# Check if flutter is installed
check_flutter() {
    if ! command -v flutter &> /dev/null; then
        echo "Error: Flutter is not installed or not in PATH"
        exit 1
    fi
}

# Process a directory
process_directory() {
    local dir="$1"
    local count=0
    local errors=0

    # Find all pubspec.yaml files recursively
    while IFS= read -r -d '' pubspec_path; do
        count=$((count + 1))
        local project_dir=$(dirname "$pubspec_path")

        echo "Found Flutter project at: $project_dir"
        echo "Running 'flutter clean'..."

        # Change to project directory and run flutter pub get
        (cd "$project_dir" && flutter clean)

        if [ $? -eq 0 ]; then
            echo "✓ Successfully updated dependencies"
        else
            echo "✗ Failed to update dependencies"
            errors=$((errors + 1))
        fi
        echo "----------------------------------------"

    done < <(find "$dir" -name "pubspec.yaml" -print0)

    # Print summary
    echo "Summary:"
    echo "Total projects found: $count"
    if [ $errors -eq 0 ]; then
        echo "All projects updated successfully!"
    else
        echo "Failed updates: $errors"
        echo "Successful updates: $((count - errors))"
    fi
}

# Main script

# Show help if requested
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    exit 0
fi

# Check if Flutter is installed
check_flutter

# Get target directory
target_dir="${1:-.}"

# Verify directory exists
if [ ! -d "$target_dir" ]; then
    echo "Error: Directory '$target_dir' does not exist"
    exit 1
fi

# Convert to absolute path
target_dir=$(cd "$target_dir" && pwd)

echo "Starting Flutter dependencies update in: $target_dir"
echo "----------------------------------------"

# Process the directory
process_directory "$target_dir"